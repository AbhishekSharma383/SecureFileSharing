<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-4">My Files</h1>
    <%= link_to new_file_path, class: 'btn btn-primary' do %>
      <i class="fas fa-upload"></i> Upload New File
    <% end %>
  </div>

  <% if @files.any? %>
    <div class="card shadow">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="thead-light">
              <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Type</th>
                <th>Size</th>
                <th>Uploaded</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @files.each do |file| %>
                <tr>
                  <td><%= file.title %></td>
                  <td><%= truncate(file.description, length: 50) %></td>
                  <td>
                    <span class="badge bg-info">
                      <%= file.content_type&.split('/')&.last&.upcase %>
                    </span>
                  </td>
                  <td><%= number_to_human_size(file.file.byte_size) if file.file.attached? %></td>
                  <td><%= time_ago_in_words(file.created_at) %> ago</td>
                  <td>
                    <div class="btn-group" role="group">
                      <%= link_to file_path(file), 
                          class: 'btn btn-outline-primary btn-sm', 
                          title: 'Download' do %>
                        <i class="fas fa-download"></i>
                      <% end %>
                      
                      <% if file.share_token %>
                        <div class="input-group input-group-sm" style="width: 200px;">
                          <input type="text" class="form-control" 
                                 value="<%= short_shared_file_url(file.share_token) %>" 
                                 readonly>
                          <%= button_to revoke_share_link_file_path(file), 
                              method: :delete, 
                              class: 'btn btn-outline-danger btn-sm',
                              form: { class: 'd-inline' },
                              data: { confirm: 'Are you sure?' } do %>
                            <i class="fas fa-unlink"></i>
                          <% end %>
                        </div>
                      <% else %>
                        <%= button_to generate_share_link_file_path(file), 
                            method: :post,
                            class: 'btn btn-outline-secondary btn-sm',
                            form: { class: 'd-inline' } do %>
                          <i class="fas fa-share-alt"></i>
                        <% end %>
                      <% end %>
                      
                      <%= button_to file_path(file), 
                          method: :delete, 
                          class: 'btn btn-outline-danger btn-sm',
                          data: { confirm: 'Are you sure?' } do %>
                        <i class="fas fa-trash"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center mt-5">
      <div class="mb-4">
        <i class="fas fa-file-upload fa-4x text-muted"></i>
      </div>
      <h3 class="text-muted">No files uploaded yet</h3>
      <p class="text-muted">Start by uploading your first file!</p>
      <%= link_to new_file_path, class: 'btn btn-primary mt-3' do %>
        <i class="fas fa-upload"></i> Upload New File
      <% end %>
    </div>
  <% end %>
</div>