<% if @file.share_token %>
  document.getElementById('share-link-<%= @file.id %>').innerHTML = `
    <div class="input-group">
      <input type="text" 
             class="form-control" 
             value="<%= short_shared_file_url(@file.share_token) %>" 
             readonly>
      <button class="btn btn-outline-secondary copy-link" 
              type="button" 
              data-clipboard-text="<%= short_shared_file_url(@file.share_token) %>">
        <i class="fas fa-copy"></i> Copy Link
      </button>
      <%= button_to revoke_share_link_file_path(@file), 
          method: :delete, 
          class: 'btn btn-outline-danger',
          form: { class: 'd-inline-block ms-2' },
          data: { confirm: 'Are you sure you want to revoke this share link?' } do %>
        <i class="fas fa-unlink"></i> Revoke
      <% end %>
    </div>
  `;
  
  new ClipboardJS('.copy-link');
<% else %>
  alert('Failed to generate share link');
<% end %> 